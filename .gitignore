.claude/settings.local.json

# Editor backups
*~
*.bak

# Local project memory — design rationale, decision history, scratch
# context that travels with the working copy but should not be
# published. Lives at ./memory/, mirrors the structure of Claude
# Code's auto-memory but stays gitignored so the GitHub repo is the
# clean public artifact and the rationale stays on the developer's
# machine.
/memory/

# Local Claude Code per-project overrides + runtime artifacts.
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/scheduled_tasks/

# Stray Antigravity CLI project pointer (auto-created when the user
# opens this dir in Antigravity — symlinks into ~/.gemini/).
/.antigravitycli/

# Editable-install metadata
*.egg-info/

# MkDocs build output (web/ -> site/)
site/
